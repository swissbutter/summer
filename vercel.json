{
  "version": 2,
  "buildCommand": "",
  "installCommand": "",
  "framework": null,
  "builds": [
    {
      "src": "api/check.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    {
      "source": "/api/check",
      "destination": "/api/check"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
